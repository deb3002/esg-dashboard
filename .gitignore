# Python bytecode from tools/convert.py — regenerated on every run
__pycache__/
*.pyc

# macOS folder metadata
.DS_Store

# Local editor / agent settings, not part of the project
.claude/

# The un-anonymised source export: real company name, CIN, contact details
# and director biographies. Kept out of version control by default — see
# README. Remove this line only if the repository is private and you have
# decided that is acceptable.
ESGReport.xls

# Generated by tools/make_test_brsr.py and tools/extract_brsr.py — both are
# rebuilt by running the tools, so there is nothing to keep in git.
tools/fixtures/
tools/extraction/
tools/fixtures/_apptest.html

# playwright-core, installed only to run tools/test_app.js. Matched with and
# without a trailing slash: when the tests run from a checkout that borrows an
# install from a folder beside it, node_modules is a symlink rather than a
# directory, and the slash form does not catch that.
node_modules
node_modules/
package-lock.json
_*.js
